{
  "name": "pearl-hub-wallet",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --config vite.android.config.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "qa": "node test/browser.mjs && node test/features.mjs && node test/review-ui.mjs && node test/transactions.mjs && node test/nock.mjs",
    "qa:review": "npm run build && node test/review-ui.mjs",
    "package": "npm run build && python3 package.py",
    "qa:languages": "node test/languages.mjs",
    "typecheck": "tsc --noEmit",
    "qa:features": "node test/features.mjs",
    "qa:transactions": "node test/transactions.mjs",
    "qa:edge": "PRL_QA_BROWSER=msedge PRL_QA_HEADED=1 node test/features.mjs",
    "store:screenshots": "node test/store-screenshots.mjs",
    "store:status": "node scripts/store-release.mjs status",
    "store:submit": "node scripts/store-release.mjs submit",
    "store:upload": "node scripts/store-release.mjs upload",
    "store:publish": "node scripts/store-release.mjs publish",
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:nock": "node scripts/sync-nock.mjs",
    "build:nock": "scripts/build-nock.sh",
    "qa:nock": "npm run build && node test/nock.mjs"
  },
  "dependencies": {
    "@scure/btc-signer": "2.4.1",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@scure/base": "2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/chrome": "0.1.38",
    "playwright": "1.58.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terryops/prl-hub-wallet.git"
  },
  "homepage": "https://pearlhub.net",
  "engines": {
    "node": ">=22.6.0"
  }
}
