{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.9",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "sidePanel",
    "identity"
  ],
  "optional_host_permissions": [
    "http://216.158.95.10/*"
  ],
  "host_permissions": [
    "https://blockbook.pearlresearch.ai/*",
    "https://blockbook.testnet.pearlresearch.ai/*",
    "https://pearlhub.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "index.html",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://blockbook.pearlresearch.ai https://blockbook.testnet.pearlresearch.ai https://pearlhub.net https://rpc.nockbox.org http://216.158.95.10:5556 https://api.coingecko.com https://nockscan.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "default_locale": "en",
  "key": ""
}
